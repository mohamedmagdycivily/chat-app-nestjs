{
  "name": "chat-service",
  "version": "0.0.1",
  "description": "Chat Service",
  "author": "Mohamed",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build main",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start main",
    "start:dev": "nest start main --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:migrate:dev": "npm run db:all:migration:up && nest start --watch",
    "start:migrate:prod": "npm run db:all:migration:up && node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:all:migration:up": "node src/db/run.ts up",
    "db:all:migration:down": "node src/db/run.ts down",
    "db:migration:main:create": "node src/db/main/run.ts create --name ",
    "db:migration:main:up": "node src/db/main/run.ts up",
    "db:migration:main:down": "node src/db/main/run.ts down",
    "load-test": "node load-test.js",
    "load-test:create-only": "CREATE_ONLY=true node load-test.js",
    "load-test:heavy": "CONCURRENT_USERS=10 OPERATIONS_PER_USER=20 MESSAGES_PER_CHAT=50 CONSISTENCY_RETRIES=20 CONSISTENCY_DELAY=1000 TIMEOUT=60000 node load-test.js",
    "load-test:extreme": "CONCURRENT_USERS=500 OPERATIONS_PER_USER=50 MESSAGES_PER_CHAT=100 CONSISTENCY_RETRIES=30 CONSISTENCY_DELAY=2000 TIMEOUT=120000 node load-test.js"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/sequelize": "^10.0.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^11.0.0",
    "axios": "^1.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.0",
    "mysql2": "^3.15.3",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "ts-node": "^10.9.2",
    "umzug": "^3.8.2",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "@golevelup/nestjs-rabbitmq": "^5.6.1",
    "@golevelup/ts-jest": "^0.6.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "dotenv/config"
    ]
  }
}
